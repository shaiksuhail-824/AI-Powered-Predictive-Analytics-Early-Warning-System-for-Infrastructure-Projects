# ==============================================================================
# MoSPI PAIMANA Early-Warning & Predictive Analytics Platform (SIH26103)
# Environment Variable Template - Copy to .env and configure for your deployment
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL
# ==============================================================================

# --- Backend Server Configuration ---
HOST=0.0.0.0
PORT=8000
DATA_STATUS=REAL DATA SOURCED FROM PAIMANA PROJECT REPORTS

# --- CORS Configuration (comma-separated origins) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- JWT Authentication & Security ---
# Generate a secure 256-bit random key: openssl rand -hex 32
JWT_SECRET=replace-with-a-secure-random-secret-key-min-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Frontend Container API Resolution ---
# Internal Docker bridge address for Next.js SSR and API proxy rewrites
INTERNAL_API_URL=http://backend:8000/api/v1
BACKEND_URL=http://backend:8000

# Next.js Production Flags
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# ==============================================================================
# MoSPI PAIMANA Early-Warning & Predictive Analytics - Root Dockerignore
# Excludes unnecessary development, virtual environments, caches, and VCS files
# ==============================================================================

.git
.gitignore
.gitattributes
.venv
.pytest_cache
__pycache__
*.pyc
*.pyo
*.pyd

# Frontend development and build artifacts
frontend/node_modules
frontend/.next
frontend/npm-debug.log*
frontend/.vscode

# Local experiments, tracking, and cache
mlruns
mlflow.db
data/dvc_remote_storage
scratch
notebooks
tests
reports/figures_ml

# Environment secrets
.env
.env.*
!.env.example

# OS and IDE files
.DS_Store
Thumbs.db
.vscode
.idea
*.log
